{
  "name": "gomruk-sual-cavab",
  "version": "1.0.0",
  "private": true,
  "description": "Gömrük müsahibə sual-cavabları (Android və veb-tətbiq)",
  "scripts": {
    "assets": "capacitor-assets generate --iconBackgroundColor '#0d5a4c' --iconBackgroundColorDark '#0d5a4c' --splashBackgroundColor '#eaefed' --splashBackgroundColorDark '#0f1614'",
    "android": "cap add android && npm run assets && cap sync android",
    "ios": "cap add ios && npm run assets && cap sync ios",
    "sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0"
  }
}
