{
  "name": "atlas-azerbaycan",
  "version": "1.0.0",
  "private": true,
  "description": "Atlas — Azərbaycan tarixi və coğrafiyası (Android və iOS tətbiqi)",
  "scripts": {
    "assets": "capacitor-assets generate --iconBackgroundColor '#0d5876' --iconBackgroundColorDark '#0d5876' --splashBackgroundColor '#f1f3f2' --splashBackgroundColorDark '#10161b'",
    "android": "cap add android && npm run assets && cap sync android",
    "ios": "cap add ios && npm run assets && cap sync ios",
    "sync": "cap sync"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/core": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0"
  }
}
